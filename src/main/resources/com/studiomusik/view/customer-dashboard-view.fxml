<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- SONORA - Dashboard Customer (TabPane: Katalog, Booking, Riwayat). Controller: STEP 7. -->
<BorderPane fx:id="rootPane" styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studiomusik.controller.CustomerDashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="navbar">
            <children>
                <VBox spacing="0.0">
                    <children>
                        <HBox alignment="BOTTOM_LEFT" spacing="0.0">
                            <children>
                                <Label styleClass="logo-sono" text="SONO" />
                                <Label styleClass="logo-ra" text="RA" />
                            </children>
                        </HBox>
                        <Label styleClass="logo-tagline" text="MUSIC STUDIO &amp; RENT" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="welcomeLabel" styleClass="navbar-user" text="Halo, Customer" />
                <Button fx:id="homeButton" onAction="#onHomeClick" styleClass="navbar-link" text="Beranda" />
                <Button fx:id="logoutButton" onAction="#onLogoutClick" styleClass="outline-button, on-dark, compact-button" text="Logout" />
            </children>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="16.0" left="32.0" right="32.0" top="16.0" />
            </padding>
            <tabs>

                <!-- TAB KATALOG -->
                <Tab fx:id="catalogTab" text="Katalog">
                    <content>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-transparent">
                            <content>
                                <VBox spacing="20.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <VBox spacing="2.0">
                                                    <children>
                                                        <Label styleClass="page-title" text="Katalog Ruangan &amp; Instrumen" />
                                                        <Label styleClass="section-subtitle" text="Harga ruangan per jam; harga instrumen per unit per sesi." />
                                                    </children>
                                                </VBox>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Button fx:id="refreshCatalogButton" onAction="#onRefreshCatalog" styleClass="outline-button, compact-button" text="Muat Ulang" />
                                            </children>
                                        </HBox>
                                        <VBox spacing="10.0" styleClass="card">
                                            <children>
                                                <Label styleClass="card-heading" text="Ruangan" />
                                                <TableView fx:id="roomCatalogTable" prefHeight="220.0">
                                                    <columns>
                                                        <TableColumn fx:id="roomNameColumn" text="Nama" />
                                                        <TableColumn fx:id="roomTypeColumn" text="Tipe" />
                                                        <TableColumn fx:id="roomPriceColumn" styleClass="numeric" text="Harga / Jam" />
                                                        <TableColumn fx:id="roomStatusColumn" text="Status" />
                                                    </columns>
                                                    <columnResizePolicy>
                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                    </columnResizePolicy>
                                                </TableView>
                                            </children>
                                        </VBox>
                                        <VBox spacing="10.0" styleClass="card">
                                            <children>
                                                <Label styleClass="card-heading" text="Instrumen" />
                                                <TableView fx:id="instrumentCatalogTable" prefHeight="260.0">
                                                    <columns>
                                                        <TableColumn fx:id="instrumentNameColumn" text="Nama" />
                                                        <TableColumn fx:id="instrumentTypeColumn" text="Tipe" />
                                                        <TableColumn fx:id="instrumentPriceColumn" styleClass="numeric" text="Harga Sewa / Unit" />
                                                        <TableColumn fx:id="instrumentStatusColumn" text="Status" />
                                                    </columns>
                                                    <columnResizePolicy>
                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                    </columnResizePolicy>
                                                </TableView>
                                            </children>
                                        </VBox>
                                        <Label fx:id="catalogMessageLabel" managed="false" maxWidth="Infinity" styleClass="message-area" visible="false" wrapText="true" />
                                    </children>
                                    <padding>
                                        <Insets bottom="16.0" right="4.0" />
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>

                <!-- TAB BOOKING -->
                <Tab fx:id="bookingTab" text="Booking">
                    <content>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-transparent">
                            <content>
                                <VBox spacing="16.0">
                                    <children>
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label styleClass="page-title" text="Buat Booking" />
                                                <Label styleClass="section-subtitle" text="Pilih jadwal dan ruangan, tambahkan instrumen bila perlu, lalu cek ketersediaan sebelum mengirim." wrapText="true" />
                                            </children>
                                        </VBox>
                                        <Label fx:id="bookingMessageLabel" managed="false" maxWidth="Infinity" styleClass="message-area" visible="false" wrapText="true" />

                                        <HBox alignment="TOP_LEFT" spacing="20.0">
                                            <children>
                                                <!-- Kolom kiri: jadwal & ruangan -->
                                                <VBox spacing="14.0" styleClass="card" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label styleClass="card-heading" text="Jadwal &amp; Ruangan" />
                                                        <VBox spacing="4.0">
                                                            <children>
                                                                <Label styleClass="form-label" text="TANGGAL" />
                                                                <DatePicker fx:id="bookingDatePicker" editable="false" maxWidth="Infinity" promptText="Pilih tanggal" />
                                                            </children>
                                                        </VBox>
                                                        <HBox spacing="14.0">
                                                            <children>
                                                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                                    <children>
                                                                        <Label styleClass="form-label" text="JAM MULAI" />
                                                                        <ComboBox fx:id="startTimeCombo" maxWidth="Infinity" promptText="Jam mulai" />
                                                                    </children>
                                                                </VBox>
                                                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                                    <children>
                                                                        <Label styleClass="form-label" text="JAM SELESAI" />
                                                                        <ComboBox fx:id="endTimeCombo" maxWidth="Infinity" promptText="Jam selesai" />
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </HBox>
                                                        <VBox spacing="4.0">
                                                            <children>
                                                                <Label styleClass="form-label" text="RUANGAN" />
                                                                <ComboBox fx:id="roomComboBox" maxWidth="Infinity" promptText="Pilih ruangan" />
                                                            </children>
                                                        </VBox>
                                                        <Button fx:id="checkAvailabilityButton" onAction="#onCheckAvailability" styleClass="secondary-button" text="Cek Ketersediaan" />
                                                        <Label fx:id="availabilityLabel" managed="false" maxWidth="Infinity" styleClass="message-area" visible="false" wrapText="true" />
                                                    </children>
                                                </VBox>

                                                <!-- Kolom kanan: instrumen -->
                                                <VBox spacing="14.0" styleClass="card" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label styleClass="card-heading" text="Instrumen (opsional)" />
                                                        <HBox alignment="BOTTOM_LEFT" spacing="12.0">
                                                            <children>
                                                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                                    <children>
                                                                        <Label styleClass="form-label" text="INSTRUMEN" />
                                                                        <ComboBox fx:id="instrumentComboBox" maxWidth="Infinity" promptText="Pilih instrumen" />
                                                                    </children>
                                                                </VBox>
                                                                <VBox spacing="4.0">
                                                                    <children>
                                                                        <Label styleClass="form-label" text="JUMLAH" />
                                                                        <Spinner fx:id="quantitySpinner" editable="true" initialValue="1" max="99" min="1" prefWidth="90.0" />
                                                                    </children>
                                                                </VBox>
                                                                <Button fx:id="addInstrumentButton" onAction="#onAddInstrument" prefHeight="42.0" styleClass="outline-button" text="Tambah" />
                                                            </children>
                                                        </HBox>
                                                        <TableView fx:id="selectedInstrumentsTable" prefHeight="190.0">
                                                            <columns>
                                                                <TableColumn fx:id="selInstrumentNameColumn" text="Instrumen" />
                                                                <TableColumn fx:id="selInstrumentPriceColumn" styleClass="numeric" text="Harga / Unit" />
                                                                <TableColumn fx:id="selInstrumentQtyColumn" styleClass="numeric" text="Jumlah" />
                                                                <TableColumn fx:id="selInstrumentSubtotalColumn" styleClass="numeric" text="Subtotal" />
                                                            </columns>
                                                            <columnResizePolicy>
                                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                            </columnResizePolicy>
                                                        </TableView>
                                                        <HBox spacing="10.0">
                                                            <children>
                                                                <Button fx:id="removeInstrumentButton" onAction="#onRemoveInstrument" styleClass="outline-button, compact-button" text="Hapus Terpilih" />
                                                                <Button fx:id="clearInstrumentsButton" onAction="#onClearInstruments" styleClass="outline-button, compact-button" text="Kosongkan" />
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <!-- Estimasi & kirim -->
                                        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="cost-box">
                                            <children>
                                                <VBox spacing="2.0">
                                                    <children>
                                                        <Label styleClass="form-label" text="ESTIMASI TOTAL BIAYA" />
                                                        <Label fx:id="estimatedCostLabel" styleClass="cost-value" text="Rp 0" />
                                                        <Label fx:id="estimateInfoLabel" styleClass="caption" text="Estimasi dihitung ulang oleh sistem saat booking dikirim." wrapText="true" />
                                                    </children>
                                                </VBox>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Button fx:id="estimateButton" onAction="#onEstimateCost" styleClass="outline-button" text="Hitung Estimasi" />
                                                <Button fx:id="resetBookingButton" onAction="#onResetBookingForm" styleClass="outline-button" text="Reset" />
                                                <Button fx:id="createBookingButton" onAction="#onCreateBooking" styleClass="primary-button" text="Buat Booking" />
                                            </children>
                                        </HBox>
                                    </children>
                                    <padding>
                                        <Insets bottom="16.0" right="4.0" />
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>

                <!-- TAB RIWAYAT -->
                <Tab fx:id="historyTab" text="Riwayat">
                    <content>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-transparent">
                            <content>
                                <VBox spacing="16.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <VBox spacing="2.0">
                                                    <children>
                                                        <Label styleClass="page-title" text="Riwayat Booking" />
                                                        <Label styleClass="section-subtitle" text="Hanya menampilkan booking milik akun yang sedang login." />
                                                    </children>
                                                </VBox>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Button fx:id="refreshHistoryButton" onAction="#onRefreshHistory" styleClass="outline-button, compact-button" text="Muat Ulang" />
                                            </children>
                                        </HBox>
                                        <Label fx:id="historyMessageLabel" managed="false" maxWidth="Infinity" styleClass="message-area" visible="false" wrapText="true" />
                                        <VBox spacing="10.0" styleClass="card">
                                            <children>
                                                <TableView fx:id="historyTable" prefHeight="280.0">
                                                    <columns>
                                                        <TableColumn fx:id="historyIdColumn" maxWidth="90.0" minWidth="60.0" text="No." />
                                                        <TableColumn fx:id="historyDateColumn" text="Tanggal" />
                                                        <TableColumn fx:id="historyStartColumn" text="Mulai" />
                                                        <TableColumn fx:id="historyEndColumn" text="Selesai" />
                                                        <TableColumn fx:id="historyRoomColumn" text="Ruangan" />
                                                        <TableColumn fx:id="historyStatusColumn" text="Status" />
                                                        <TableColumn fx:id="historyTotalColumn" styleClass="numeric" text="Total Biaya" />
                                                    </columns>
                                                    <columnResizePolicy>
                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                    </columnResizePolicy>
                                                </TableView>
                                            </children>
                                        </VBox>
                                        <VBox spacing="10.0" styleClass="card">
                                            <children>
                                                <Label fx:id="historyDetailTitleLabel" styleClass="card-heading" text="Detail instrumen booking" />
                                                <Label fx:id="historyDetailInfoLabel" styleClass="card-text" text="Pilih satu booking pada tabel di atas untuk melihat detail instrumennya." wrapText="true" />
                                                <TableView fx:id="historyInstrumentsTable" prefHeight="170.0">
                                                    <columns>
                                                        <TableColumn fx:id="histInstrumentNameColumn" text="Instrumen" />
                                                        <TableColumn fx:id="histInstrumentPriceColumn" styleClass="numeric" text="Harga / Unit" />
                                                        <TableColumn fx:id="histInstrumentQtyColumn" styleClass="numeric" text="Jumlah" />
                                                        <TableColumn fx:id="histInstrumentSubtotalColumn" styleClass="numeric" text="Subtotal" />
                                                    </columns>
                                                    <columnResizePolicy>
                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                    </columnResizePolicy>
                                                </TableView>
                                            </children>
                                        </VBox>
                                    </children>
                                    <padding>
                                        <Insets bottom="16.0" right="4.0" />
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
